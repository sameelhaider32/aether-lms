{
  "name": "aether-lms",
  "version": "1.3.1",
  "private": true,
  "license": "MIT",
  "description": "MV3 presentation enhancement for the original LUMS Sakai workspace",
  "scripts": {
    "test": "npm run test:unit && npm run test:startup && node tests/browser.cjs && node tests/fallbacks.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:unit": "node tests/unit.cjs && node tests/lifecycle.cjs",
    "test:stress": "node tests/stress.cjs",
    "package": "python scripts/package.py",
    "test:startup": "node tests/startup.cjs && node tests/portal-startup.cjs"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "jszip": "3.10.2",
    "pptxgenjs": "4.0.1"
  }
}
